NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/proshop

JWT_SECRET=your_jwt_secret

PAYPAL_CLIENT_ID=your_paypal_client_id

COHERE_API_KEY=your_cohere_secret
QDRANT_URL=http://localhost:6333

N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_API_KEY=your_n8n_api_key

MCP_BEARER_TOKEN=your_mcp_bearer_token

ANTHROPIC_API_KEY=your_anthropic_api_key

# Chat assistant (backend proxy at /api/assistant/chat)
# Backend forwards to LiteLLM smart-router (PII → qwen-local, clean → claude-haiku).
# Server-side only — never exposed to the browser.
# Local `npm run dev`: http://localhost:4000
# Docker compose: overridden to http://litellm:4000 via docker-compose.yml
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-master
LITELLM_MODEL=smart-router

# ChatLog content logging (Mongo collection `chatlogs`).
# 1 (default) — stores user message, model reply, full payload per request.
# 0          — meta only (no content). Recommended for prod.
# PII risk: enabling this writes user PII to MongoDB. Restrict DB access.
CHAT_LOG_CONTENT=1

# simulate_wf1.py
FEATURE_ID=search_autosuggest
INVALID_EVERY=3
BURST=15
