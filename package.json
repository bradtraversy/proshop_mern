{
  "name": "proshop",
  "version": "1.0.0",
  "description": "MERN shopping cart app",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server",
    "server": "nodemon --ignore backend/features.json --ignore backend/data backend/server",
    "client": "NODE_OPTIONS=--openssl-legacy-provider npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d",
    "test": "npm run test:mcp-features && npm run test:mcp-rag",
    "test:mcp-features": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config homework/M6/stage4-tests-agent/service-1-tests/jest.config.cjs",
    "test:mcp-rag": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config homework/M6/stage4-tests-agent/service-2-tests/jest.config.cjs",
    "test:stage2": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config homework/M6/stage2-fix-top3/jest.config.cjs",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix frontend && npm run build --prefix frontend"
  },
  "author": "Brad Traversy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.1.4",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.10.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "concurrently": "^5.3.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^2.0.4",
    "supertest": "^7.2.2"
  }
}
