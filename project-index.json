{
  "name": "proshop_mern",
  "type": "fullstack-monorepo",
  "description": "MERN e-commerce study project (ProShop fork) extended with MCP feature-flag server, MCP RAG search, frontend feature-flags layer, and n8n AutoPilot integration (course modules M3-M5).",
  "tech_stack": {
    "runtime": "Node 22 (ESM)",
    "backend": "Express 4 + Mongoose 5",
    "database": "MongoDB 7",
    "frontend": "React 16.13 (CRA react-scripts 3.4.3) + Redux 4 + redux-thunk + React Router 5 + React Bootstrap",
    "mcp_sdk": "@modelcontextprotocol/sdk ^1.29",
    "vector_db": "Qdrant 1.14",
    "embeddings": "Cohere embed-multilingual-v3.0 (1024d)",
    "payments": "PayPal Sandbox (react-paypal-button-v2)",
    "auth": "JWT (HS256, 30d) + bcryptjs",
    "uploads": "multer",
    "integrations": "n8n webhook (Cloudflare tunnel for ephemeral URLs)"
  },
  "subprojects": {
    "backend": {
      "path": "backend/",
      "description": "Express REST API + Mongoose models + JWT auth + multer uploads + feature-flag read API + n8n proxy.",
      "entry": "backend/server.js",
      "tech": "Express 4, Mongoose 5, ESM",
      "key_paths": {
        "controllers": "backend/controllers/",
        "routes": "backend/routes/",
        "middleware": "backend/middleware/",
        "models": "backend/models/",
        "utils": "backend/utils/",
        "config": "backend/config/db.js",
        "feature_flag_store": "backend/features.json",
        "seeder": "backend/seeder.js"
      }
    },
    "frontend": {
      "path": "frontend/",
      "description": "Create React App + Redux store. Cart in localStorage, JWT in localStorage, feature flags in Redux, traffic bucket in sessionStorage.",
      "entry": "frontend/src/index.js",
      "tech": "React 16.13, Redux 4, react-scripts 3.4.3",
      "key_paths": {
        "screens": "frontend/src/screens/",
        "components": "frontend/src/components/",
        "actions": "frontend/src/actions/",
        "reducers": "frontend/src/reducers/",
        "hooks": "frontend/src/hooks/",
        "feature_flag_hook": "frontend/src/hooks/useFeatureEnabled.js",
        "proxy_setup": "frontend/src/setupProxy.js"
      }
    },
    "mcp-features": {
      "path": "mcp-features/",
      "description": "MCP server exposing 4 tools + 1 resource over backend/features.json. Dual transport: stdio (local Claude Code/Cursor) and StreamableHTTP (Docker + Cloudflare tunnel for n8n access).",
      "entry": "mcp-features/index.js",
      "tech": "@modelcontextprotocol/sdk, express, zod",
      "key_paths": {
        "server": "mcp-features/index.js",
        "dockerfile": "mcp-features/Dockerfile"
      },
      "transports": [
        "stdio",
        "streamable-http"
      ],
      "auth": {
        "stdio": "none (trusted env)",
        "http": "Bearer MCP_BEARER_TOKEN (fail-open if empty — Stage3 SEC HIGH)"
      }
    },
    "mcp-rag": {
      "path": "mcp-rag/",
      "description": "MCP server for semantic search over project-data/ markdown. Uses Cohere embeddings (multilingual) and Qdrant vector DB. stdio-only.",
      "entry": "mcp-rag/index.js",
      "tech": "@modelcontextprotocol/sdk, @qdrant/js-client-rest, cohere-ai, zod, dotenv",
      "key_paths": {
        "server": "mcp-rag/index.js",
        "ingest": "mcp-rag/ingest.js",
        "chunks_dump": "mcp-rag/chunks.jsonl"
      },
      "reindex_command": "cd mcp-rag && node ingest.js"
    },
    "project-data": {
      "path": "project-data/",
      "description": "RAG-indexed living documentation. Source of truth for the proshop-rag MCP server.",
      "key_paths": {
        "architecture": "project-data/architecture.md",
        "adrs": "project-data/adrs/",
        "api": "project-data/api/",
        "features": "project-data/features/",
        "incidents": "project-data/incidents/",
        "pages": "project-data/pages/",
        "runbooks": "project-data/runbooks/",
        "feature_flags_spec": "project-data/feature-flags-spec.md",
        "mcp_design": "project-data/mcp-design-principles.md",
        "mcp_rag_spec": "project-data/mcp-rag-project-data.md",
        "best_practices": "project-data/best-practices.md",
        "dev_history": "project-data/dev-history.md",
        "glossary": "project-data/glossary.md"
      }
    }
  },
  "system_folders": {
    "uploads/": "User-uploaded product / review images (multer static serve).",
    "docs-archived-2026-05-23/": "Historical docs/ folder, archived in M6 stage1. Read-only — do not modify.",
    "homework/": "Course homework deliverables (M4, M5, M6 stage1-3).",
    "homework/M6/stage1-code-review/": "Multi-mate code review baseline (security + performance + architecture + synthesis).",
    "homework/M6/stage2-fix-top3/": "Top-3 fixes (feature-flag store, order endpoint, auth on integration routes) + characterization tests.",
    "homework/M6/stage3-living-docs/": "Stage3 living documentation pack (docs audit, plan, specs, docs-new, proposed ADRs, synthesis).",
    ".claude/agents/": "Agent role definitions (security-mate, performance-mate, architecture-mate, legacy-auditor-mate, test-writer-mate, n8n-*).",
    ".claude/scripts/": "Maintenance scripts (update_project_index.py — refreshes filesystem_tree)."
  },
  "root_files": {
    "CLAUDE.md": "Project conventions, commands, MCP/RAG/feature-flag overview, MR review checklist. Authoritative.",
    "DESIGN.md": "Design system + anti-AI-slop guards. Required reading before any frontend work.",
    "README.md": "Quickstart + setup.",
    "FINDINGS.md": "Early M0/M1 findings table (historical, superseded by M6 stage1/2).",
    "indexation-and-onboarding.md": "C4 diagram generation prompt (M4 artifact, misnamed).",
    "package.json": "Root Node manifest (backend deps + dev scripts).",
    "docker-compose.yml": "Compose for backend + frontend + MongoDB + mcp-features + mcp-tunnel.",
    ".mcp.json": "MCP server registrations (proshop-features stdio, proshop-rag stdio).",
    ".env.example": "Required env vars template.",
    "project-index.json": "This file — machine-readable repo map. Auto-updated by .claude/scripts/update_project_index.py."
  },
  "hard_rules": [
    "ALWAYS read project-index.json FIRST at session start.",
    "All backend imports use .js extension (ESM).",
    "Run `cd mcp-rag && node ingest.js` after any change to project-data/.",
    "Never edit project-data/adrs/ numbering — append adr-008+ for new decisions.",
    "Never edit docs-archived-2026-05-23/ — it is read-only.",
    "Frontend changes — read DESIGN.md FIRST. DESIGN.md wins over code on visual conflicts.",
    "Commit messages must start with `COURSE:` prefix.",
    "Never add `Co-Authored-By: Claude` (global CLAUDE.md rule).",
    "Feature flags: backend uses isFeatureEnabled() from utils/featureFlag.js, frontend uses useFeatureEnabled() hook — never raw flags.find.",
    "MCP_BEARER_TOKEN must NOT be empty in Docker HTTP mode (fail-open vulnerability)."
  ],
  "ai_routing": {
    "how does X work in proshop": "search via proshop-rag MCP tool (search_project_docs)",
    "feature flag operations": "mcp-features MCP server (get_feature_info, set_feature_state, adjust_traffic_rollout, list_features)",
    "architecture decisions": "project-data/adrs/",
    "API contracts": "project-data/api/ + homework/M6/stage3-living-docs/docs-new/api/ (featureflags, autopilot)",
    "module-level specs (M3-M5)": "homework/M6/stage3-living-docs/specs/",
    "operational procedures": "project-data/runbooks/",
    "design system": "DESIGN.md",
    "project conventions": "CLAUDE.md",
    "Stage1 findings baseline": "homework/M6/stage1-code-review/synthesis.md",
    "Stage3 delta findings": "homework/M6/stage3-living-docs/synthesis.md"
  },
  "adrs": [
    {
      "id": "adr-001",
      "title": "MongoDB vs Postgres",
      "status": "accepted"
    },
    {
      "id": "adr-002",
      "title": "Redux vs Context",
      "status": "accepted (RTK-Query migration noted)"
    },
    {
      "id": "adr-003",
      "title": "JWT vs Session",
      "status": "accepted with debt"
    },
    {
      "id": "adr-004",
      "title": "PayPal vs Stripe",
      "status": "accepted"
    },
    {
      "id": "adr-005",
      "title": "Bootstrap vs Tailwind",
      "status": "accepted"
    },
    {
      "id": "adr-006",
      "title": "n8n AutoPilot integration",
      "status": "accepted (partial compliance — see Stage3 ARCH-DELTA-04)"
    },
    {
      "id": "adr-007",
      "title": "Feature-flag storage and ownership",
      "status": "accepted (NOT compliant — see Stage3 ARCH-DELTA-01/02/03)"
    },
    {
      "id": "adr-008",
      "title": "MCP features dual-transport (stdio + StreamableHTTP)",
      "status": "proposed (homework/M6/stage3-living-docs/proposed-adrs/)"
    }
  ],
  "ports": {
    "backend": 5001,
    "mongodb": 27017,
    "qdrant_http": 6333,
    "mcp-features_http": 7777,
    "frontend_dev": 3000
  },
