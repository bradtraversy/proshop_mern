{
  "name": "proshop_mern",
  "type": "fullstack-monorepo",
  "description": "MERN e-commerce fork (Brad Traversy proshop) extended for the AI-dev course with two Node/TypeScript MCP servers (feature-flags + search-docs RAG) and a polyglot data layer.",
  "tech_stack": {
    "backend": "Node.js + Express 4.17 + Mongoose 5.10 (MongoDB), ES modules",
    "frontend": "React 18 + Redux 4 (thunk) + React Router v5, Tailwind v4 + shadcn-style components, Vite 6",
    "feature_flags_mcp": "Node + TypeScript MCP server (stdio), @modelcontextprotocol/sdk",
    "search_docs_mcp": "Node + TypeScript MCP server (RAG): OpenAI embeddings + PostgreSQL/pgvector (pg)",
    "databases": [
      "MongoDB (orders/users/products)",
      "backend/features.json (feature flags)",
      "PostgreSQL + pgvector (RAG embeddings)"
    ],
    "auth": "JWT (jsonwebtoken) + bcryptjs"
  },
  "subprojects": {
    "backend": {
      "path": "backend/",
      "description": "Express REST API: auth, products, orders, uploads, feature flags. Controller -> Mongoose model (no service layer).",
      "entry": "backend/server.js",
      "port": 5001,
      "tech": "Node + Express 4 + Mongoose 5 (ESM)",
      "key_paths": {
        "server": "backend/server.js",
        "config": "backend/config/db.js",
        "controllers": "backend/controllers/",
        "routes": "backend/routes/",
        "middleware": "backend/middleware/",
        "models": "backend/models/",
        "utils": "backend/utils/",
        "seeder": "backend/seeder.js",
        "feature_flags_data": "backend/features.json"
      }
    },
    "frontend": {
      "path": "frontend/",
      "description": "React SPA storefront + admin. Redux thunk store; Tailwind v4 + shadcn-style components under src/components/good-shop/.",
      "entry": "frontend/src/index.js",
      "port": 3000,
      "tech": "React 18 + Redux 4 + React Router v5 + Vite 6 + Tailwind v4",
      "key_paths": {
        "app_shell": "frontend/src/App.js",
        "store": "frontend/src/store.js",
        "actions": "frontend/src/actions/",
        "reducers": "frontend/src/reducers/",
        "screens": "frontend/src/screens/",
        "components": "frontend/src/components/",
        "design_system_components": "frontend/src/components/good-shop/"
      }
    },
    "mcp-server-feature-flags": {
      "path": "mcp-server-feature-flags/",
      "description": "MCP server (Node/TypeScript, stdio) exposing feature-flag tools that read/write backend/features.json. Second writer of that file alongside the backend controller.",
      "entry": "mcp-server-feature-flags/src/index.ts",
      "tech": "Node + TypeScript + @modelcontextprotocol/sdk + zod",
      "key_paths": {
        "source": "mcp-server-feature-flags/src/index.ts",
        "build": "mcp-server-feature-flags/dist/index.js",
        "spec": "docs/specs/feature-flags-mcp-spec.md"
      }
    },
    "mcp-server-search-docs": {
      "path": "mcp-server-search-docs/",
      "description": "RAG MCP server (Node/TypeScript): embeds a query via OpenAI and runs a pgvector similarity search over the project-docs corpus.",
      "entry": "mcp-server-search-docs/src/index.ts",
      "tech": "Node + TypeScript + OpenAI + pg (PostgreSQL/pgvector)",
      "key_paths": {
        "source": "mcp-server-search-docs/src/index.ts",
        "build": "mcp-server-search-docs/dist/index.js",
        "spec": "docs/specs/search-docs-rag-mcp-spec.md",
        "corpus": "docs/project-data/chunks.jsonl"
      }
    },
    "scripts": {
      "path": "scripts/",
      "description": "Node RAG ingestion pipeline: chunk markdown -> embed -> search over pgvector.",
      "tech": "Node",
      "key_paths": {
        "chunk": "scripts/chunk_markdown.js",
        "embed": "scripts/embed_chunks.js",
        "search": "scripts/search_chunks.js"
      }
    }
  },
  "system_folders": {
    ".claude/": "Claude Code config: agent definitions, scripts, settings",
    ".claude/agents/": "Sub-agent definitions (security/performance/architecture/legacy-auditor/test-writer mates)",
    ".claude/scripts/": "Maintenance scripts incl. update_project_index.py",
    ".github/": "GitHub config incl. copilot-instructions.md (agent rules)",
    "docs/": "Living documentation: README index, architecture, specs, adr, api, features, pages, runbooks, guides, design, project-data",
    "docs/specs/": "Per-module 4-step reverse-engineering specs",
    "docs/adr/": "Architecture Decision Records (canonical 0001-0004 + carried adr-001/002/004)",
    "docs-archived-2026-05-29/": "Historical/superseded docs archived during the M6 Stage 3 audit (never deleted)",
    "uploads/": "User-uploaded files served at /uploads (admin-only upload since 2026-05-29)",
    "homework-m6/": "M6 homework submission artifacts (out of scope for code/docs audit)"
  },
  "root_files": {
    "README.md": "Project overview, tech stack, setup",
    "DESIGN.md": "Tailwind v4 design tokens + visual direction (primary design source)",
    "FINDINGS.md": "Risk register / earlier-module audit findings",
    "package.json": "Root npm scripts (server, client, dev, data:import/destroy)",
    "docker-compose.yml": "MongoDB + (RAG Postgres) services",
    ".mcp.json / .copilot/mcp.json": "MCP server registration (feature-flags + search-docs)",
    ".env.example": "Environment variable template (canonical variable list)",
    "CLAUDE.md": "Agent rules: START HERE navigation + project-index maintenance",
    "project-index.json": "This file — machine-readable repo map"
  },
  "hard_rules": [
    "ALWAYS read project-index.json FIRST at session start for repo structure.",
    "Feature flags: use the feature-flags MCP tools; never hand-edit backend/features.json directly (two writers race on it).",
    "Docs search: use the search-docs MCP (search_project_docs); the corpus is docs/project-data/chunks.jsonl and must be re-ingested after doc edits.",
    "Preserve behavior on refactors — write characterization tests first (Vitest + supertest + mongodb-memory-server); the app has no other test suite.",
    "Use Conventional Commits (feat:, fix:, docs:, chore:, refactor:, test:).",
    "Never commit .env — .env.example is the canonical variable list.",
    "Persistence is polyglot (MongoDB + features.json + Postgres/pgvector) — do not assume Mongo-only (adr-001 is deviated).",
    "Order pricing and updateOrderToPaid are still client-trusted — do not rely on them as authoritative (open findings)."
  ],
  "ai_routing": {
    "feature_flag_queries": "feature-flags MCP get/read tools (not direct features.json reads)",
    "feature_flag_changes": "feature-flags MCP set/update tools",
    "docs_search": "search-docs MCP search_project_docs (not grep + read)",
    "structure_questions": "this project-index.json (do not walk the tree)",
    "api_design": "docs/api/ (per-resource specs)",
    "module_internals": "docs/specs/ (4-step reverse-engineering specs)"
  },
